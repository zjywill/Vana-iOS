    "经纬度坐标——只发城市名，坐标一个字都不发" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coordinates — only the city name is sent, never the coordinates"
          }
        }
