 "moves": [
  {
   "id": "neck-flex-ext",
   "zh": "颈部前后活动",
   "en": "Static Neck Flexion and Extension",
   "src": "ek",
   "scenes": [
    "颈肩",
    "办公室"
   ],
   "part": "颈部",
   "gear": "徒手,坐着就能做",
   "steps": [
    "坐直,肩膀放松往下沉,不要耸着。",
    "下巴慢慢往胸口收,后颈感觉被拉开,停一下。",
    "再慢慢抬头看向斜上方,不要一路仰到底。",
    "整个过程慢,来回几次,以不头晕为准。"
   ],
   "cue": "幅度小一点没关系,速度慢才是重点;脖子发出响声不要刻意去追。",
   "avoid": "有颈椎病、手臂发麻、头晕史的先问医生,别自己练。",
   "risk": [
    "颈"
   ],
   "floor": false,
   "files": [
    "ek-0001-tension.svg",
    "ek-0001-relaxation.svg"
   ]
  },
  {
   "id": "neck-side",
   "zh": "颈部侧屈",
   "en": "Static Neck Side Flexion",
   "src": "ek",
   "scenes": [
    "颈肩",
    "办公室"
   ],
   "part": "颈侧 / 斜方肌",
   "gear": "徒手,坐着就能做",
   "steps": [
    "坐直,右手轻轻搭在头的左侧。",
    "头往右肩方向倒,左肩主动往下沉,别跟着抬起来。",
    "手只是搭着,不要用力往下压。",
    "换另一边。"
   ],
   "cue": "拉的是肩到耳朵那条线,不是脖子后面;沉肩比压头有用得多。",
   "avoid": "手上不要发力下压;出现放射性的麻或刺痛立刻停。",
   "risk": [
    "颈"
   ],
   "floor": false,
   "files": [
    "ek-0002-tension.svg",
    "ek-0002-relaxation.svg"
   ]
  },
  {
   "id": "shoulder-cross",
   "zh": "体前交叉拉肩",
   "en": "Cross-Body Shoulder Stretch",
   "src": "wg",
   "scenes": [
    "颈肩",
    "办公室"
   ],
   "part": "肩后侧 / 上背",
   "gear": "徒手,坐着就能做",
   "steps": [
    "一条手臂伸直,横过身体前方,往对侧肩膀的方向送。",
    "另一只手托在这条手臂的肘窝附近,轻轻往身体这边带。",
    "肩后侧有拉开的感觉就停住,不要耸肩,呼吸不要屏。",
    "换一边做同样的动作。"
   ],
   "cue": "托的位置在肘窝附近,不要压肘尖;被拉的那侧肩膀始终往下沉。",
   "avoid": "肩关节脱位过、做过肩部手术、抬手就疼的先问医生。",
   "risk": [
    "肩"
   ],
   "floor": false,
   "files": [
    "wg-cross-body-shoulder-stretch-1.svg",
    "wg-cross-body-shoulder-stretch-2.svg",
    "wg-cross-body-shoulder-stretch-3.svg"
   ]
  },
  {
   "id": "arm-circles",
   "zh": "手臂绕环",
   "en": "Arm Circles",
   "src": "wg",
   "scenes": [
    "颈肩",
    "办公室",
    "跑前"
   ],
   "part": "肩 / 上背",
   "gear": "徒手,站着或坐着都行",
   "steps": [
    "两臂侧平举,手掌朝下,肩膀先往下沉一点。",
    "从小圈开始向前绕,圈慢慢变大。",
    "再换成向后绕,同样从小到大。",
    "整个过程手臂不用绷紧,肩膀不要跟着耸起来。"
   ],
   "cue": "圈的大小以肩膀不发出刺痛为准;绕的时候脖子放松,不要跟着一起转。",
   "avoid": "肩周炎急性期、肩袖损伤没好的时候别做。",
   "risk": [
    "肩"
   ],
   "floor": false,
   "files": [
    "wg-arm-circles-1.svg",
    "wg-arm-circles-2.svg",
    "wg-arm-circles-3.svg"
   ]
  },
  {
   "id": "triceps-towel",
   "zh": "毛巾辅助三头肌伸展",
   "en": "Standing Triceps Extension with Towel",
   "src": "ek",
   "scenes": [
    "颈肩",
    "办公室"
   ],
   "part": "上臂后侧 / 肩",
   "gear": "一条毛巾",
   "steps": [
    "右手抓毛巾一端,从头顶后面垂下来。",
    "左手在腰后抓住毛巾另一端。",
    "下面那只手轻轻往下带,上面那条手臂后侧会有拉伸感。",
    "换边再做一次。"
   ],
   "cue": "肋骨不要往前顶,腰不要跟着塌下去。",
   "avoid": "肩膀抬到一半就疼的,不要靠毛巾硬拽过去。",
   "risk": [
    "肩"
   ],
   "floor": false,
   "files": [
    "ek-0202-tension.svg",
    "ek-0202-relaxation.svg"
   ]
  },
  {
   "id": "doorway-chest",
   "zh": "门框开胸",
   "en": "Doorway Chest Stretch",
   "src": "wg",
   "scenes": [
    "颈肩",
    "办公室",
    "腰背"
   ],
   "part": "胸前 / 肩前侧",
   "gear": "一个门框",
   "steps": [
    "站在门口,两条前臂分别贴在门框两侧,肘部大约与肩同高。",
    "一只脚往前迈一小步,身体重心跟着往前送。",
    "胸前被拉开的时候停住,不要把腰往前顶、也不要耸肩。",
    "肘的高低换一换,拉到的位置也跟着变。"
   ],
   "cue": "拉开的是胸口不是肩关节;肘抬高一点偏胸上部,放低一点偏胸下部,挑最舒服的那个高度。",
   "avoid": "肩前侧有过撞击或脱位史的先问康复师。",
   "risk": [
    "肩"
   ],
   "floor": false,
   "files": [
    "wg-doorway-chest-stretch-1.svg",
    "wg-doorway-chest-stretch-2.svg",
    "wg-doorway-chest-stretch-3.svg"
   ]
  },
  {
   "id": "scapular-pushup",
   "zh": "肩胛俯卧撑",
   "en": "Scapular Push-up",
   "src": "wg",
   "scenes": [
    "颈肩",
    "力量"
   ],
   "part": "前锯肌 / 上背",
   "gear": "徒手,需要趴下",
   "steps": [
    "摆成俯卧撑的支撑姿势,手臂全程伸直不弯。",
    "只让两片肩胛骨慢慢往中间夹,胸口随之下沉一点点。",
    "再把肩胛骨往两边推开,上背轻轻拱起。",
    "来回做,幅度很小,手肘始终锁着。"
   ],
   "cue": "动的只有肩胛骨,手肘一弯就变成普通俯卧撑了;觉得手腕吃力可以改成跪姿。",
   "avoid": "手腕疼、肩膀抬起来就响且伴随疼痛的别做。",
   "risk": [
    "腕",
    "肩"
   ],
   "floor": true,
   "files": [
    "wg-scapular-push-up-1.svg",
    "wg-scapular-push-up-2.svg",
    "wg-scapular-push-up-3.svg"
   ]
  },
  {
   "id": "prone-y-raise",
   "zh": "俯卧 Y 字抬举",
   "en": "Prone Y Raise",
   "src": "wg",
   "scenes": [
    "颈肩",
    "腰背"
   ],
   "part": "下斜方肌 / 上背",
   "gear": "徒手,需要趴下",
   "steps": [
    "趴在垫子上,额头轻轻贴地,两臂在头顶前方摆成一个 Y。",
    "大拇指朝上,肩膀先往下沉、往后收。",
    "把两条手臂抬离地面一点,停一下再慢慢放下。",
    "抬的时候脖子不要跟着仰,眼睛看地面。"
   ],
   "cue": "抬得越低越好做,重点是肩胛骨往下往后,不是手举多高。",
   "avoid": "腰不舒服可以在肚子下面垫一个薄枕头;腰椎有伤的先问医生。",
   "risk": [
    "肩",
    "腰"
   ],
   "floor": true,
   "files": [
    "wg-prone-y-raise-1.svg",
    "wg-prone-y-raise-2.svg",
    "wg-prone-y-raise-3.svg"
   ]
  },
  {
   "id": "cat-cow",
   "zh": "猫牛式（拱背沉腰）",
   "en": "Cat-Cow Stretch",
   "src": "wg",
   "scenes": [
    "腰背",
    "睡前",
    "办公室"
   ],
   "part": "脊柱 / 腰背",
   "gear": "徒手,需要跪下",
   "steps": [
    "四点跪撑,手在肩膀正下方,膝盖在髋正下方。",
    "呼气,慢慢把背拱起来,下巴往胸口收,像一只弓背的猫。",
    "吸气,再慢慢让腰沉下去、胸口打开,尾骨轻轻上翘。",
    "跟着呼吸来回,不追求幅度。"
   ],
   "cue": "一节一节地动,不是整段腰塌下去;手腕不舒服可以改成拳撑或前臂撑。",
   "avoid": "腰椎间盘突出急性期、腰往后仰就放射到腿的先问医生。",
   "risk": [
    "腰",
    "腕"
   ],
   "floor": true,
   "files": [
    "wg-cat-cow-stretch-1.svg",
    "wg-cat-cow-stretch-2.svg",
    "wg-cat-cow-stretch-3.svg"
   ]
  },
  {
   "id": "childs-pose",
   "zh": "婴儿式",
   "en": "Child's Pose",
   "src": "wg",
   "scenes": [
    "腰背",
    "睡前",
    "跑后"
   ],
   "part": "腰背 / 髋",
   "gear": "需要跪地,垫子或地毯上做",
   "steps": [
    "跪坐下来,两个大脚趾靠在一起,膝盖分开一些。",
    "上半身往前趴,额头找地面。",
    "手臂往前伸直,或者放在身体两侧手心朝上。",
    "在这里正常呼吸,感觉后背一点点松开。"
   ],
   "cue": "这是个休息姿势,不用使劲;坐不到脚跟上就在屁股下面垫个抱枕。",
   "avoid": "孕期、膝盖弯到底就疼的不要做。",
   "risk": [
    "膝"
   ],
   "floor": true,
   "files": [
    "wg-childs-pose-1.svg",
